# ==============================================================================
# DISCORD BOT ENTERPRISE EDITION - ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

# Node Environment
NODE_ENV=production
LOG_LEVEL=info

# Discord Application Credentials (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_development_guild_id_optional_for_guild_commands

# Database Connection (MySQL dengan Prisma ORM)
# Example: mysql://username:password@localhost:3306/discord_bot
DATABASE_URL="mysql://root:password@localhost:3306/discord_bot"

# Redis Cache & Rate Limit (Optional - leave empty if not running Redis)
REDIS_URL=redis://localhost:6379

# Web Admin Dashboard Configuration
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000
DASHBOARD_BASE_URL=http://localhost:3000
DASHBOARD_SESSION_SECRET=change_this_to_a_minimum_32_character_random_string_in_production
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Optional External API Keys (Leave blank or fill with your provider keys)
WEATHER_API_KEY=
TRANSLATE_API_KEY=
