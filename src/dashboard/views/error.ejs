<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Terjadi Kesalahan' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif;
      background-color: #080c14;
      background-image: 
        radial-gradient(circle at 20% 20%, rgba(239, 68, 68, 0.2) 0%, transparent 45%),
        radial-gradient(circle at 80% 80%, rgba(99, 102, 241, 0.18) 0%, transparent 45%);
      background-attachment: fixed;
      background-size: cover;
      color: #f1f5f9;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 1.5rem;
      -webkit-font-smoothing: antialiased;
    }
    .card {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(20px) saturate(160%);
      -webkit-backdrop-filter: blur(20px) saturate(160%);
      border: 1px solid rgba(255, 255, 255, 0.14);
      padding: 3rem 2.5rem;
      border-radius: 22px;
      max-width: 520px;
      width: 100%;
      box-shadow: 0 16px 45px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.18);
    }
    h1 { font-size: 2rem; color: #f87171; margin-bottom: 1rem; font-weight: 700; letter-spacing: -0.3px; }
    p { color: #94a3b8; margin-bottom: 2.25rem; line-height: 1.6; font-size: 1.05rem; }
    .btn {
      padding: 0.75rem 2rem;
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.95), rgba(139, 92, 246, 0.9));
      color: #fff;
      text-decoration: none;
      font-weight: 600;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border: 1px solid rgba(255, 255, 255, 0.25);
      box-shadow: 0 8px 24px rgba(99, 102, 241, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.3);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn:hover {
      background: linear-gradient(135deg, rgba(79, 70, 229, 0.98), rgba(124, 58, 237, 0.95));
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(99, 102, 241, 0.5);
    }
  </style>
</head>
<body>
  <div class="card">
    <div style="font-size: 3rem; color: #f87171; margin-bottom: 1rem;"><i class="fa-solid fa-triangle-exclamation"></i></div>
    <h1><%= title %></h1>
    <p><%= message %></p>
    <a href="/" class="btn"><i class="fa-solid fa-house"></i> Kembali ke Beranda</a>
  </div>
</body>
</html>
