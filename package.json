{
  "name": "discord-bot-enterprise",
  "version": "1.0.0",
  "description": "Enterprise-grade Modular Discord Bot with Database, Dashboard, and PM2 Support",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy:commands": "node scripts/deploy-commands.js",
    "deploy:commands:guild": "node scripts/deploy-commands.js --guild",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "discord",
    "discord.js",
    "bot",
    "enterprise",
    "moderation",
    "tickets",
    "leveling",
    "economy",
    "giveaways",
    "dashboard",
    "prisma"
  ],
  "author": "Enterprise Architecture Team",
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@distube/ytdl-core": "^5.1.1",
    "@prisma/client": "^6.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.0.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "play-dl": "^1.9.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
